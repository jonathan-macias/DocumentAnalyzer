# --- OpenAI (required) ---
OPENAI_API_KEY=sk-...

# --- Models ---
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
VISION_MODEL=gpt-6-luna
EMBEDDINGS_MODEL=text-embedding-3-small

# --- Classification ---
DEFAULT_THRESHOLD=0.80
CATALOG_TOP_K=4

# --- Chunking / retrieval ---
# recursive | semantic   (semantic requires: uv sync --extra semantic)
CHUNKING_STRATEGY=recursive
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
RETRIEVAL_K=4
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6

# --- Extraction ---
# auto | full | retrieval   (retrieval forces hybrid search even for short documents)
EXTRACTION_MODE=auto
FULL_CONTEXT_MAX_TOKENS=12000

# --- Ingestion ---
MAX_DOCUMENT_MB=20
DOWNLOAD_TIMEOUT_SECONDS=30

# --- LangSmith tracing (optional) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=document-analyze
