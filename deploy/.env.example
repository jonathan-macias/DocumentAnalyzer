# Template for /opt/document-analyzer/.env on the Orange Pi (owner gh-runner, chmod 600).
# Secrets live ONLY on the Pi: never commit real values.

# --- Managed by deploy.sh (leave IMAGE_TAG empty, the first deploy fills it) ---
IMAGE_TAG=
IMAGE_NAMESPACE=ghcr.io/jonathan-macias

# --- Secrets (required) ---
# OpenAI key used for classification, extraction, vision OCR and embeddings
OPENAI_API_KEY=
# Clients must send this value in the X-API-Key header (generate with: openssl rand -hex 32)
API_KEY=

# --- Optional overrides (defaults live in app/core/config.py) ---
# LLM_MODEL=gpt-6-luna
# VISION_MODEL=gpt-6-luna
# EMBEDDINGS_MODEL=text-embedding-3-small
# DEFAULT_THRESHOLD=0.80
# EXTRACTION_MODE=auto
# MAX_DOCUMENT_MB=20
# LOG_LEVEL=INFO

# --- LangSmith tracing (optional) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=document-analyzer
